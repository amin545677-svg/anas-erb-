rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Staging only: users may access only their own latest snapshot.
    // No access is granted to any other collection or snapshot document.
    match /users/{uid}/snapshots/{snapshotId} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && snapshotId == "latest";
    }
  }
}
