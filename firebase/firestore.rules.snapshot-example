rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ANAS ERP snapshot is isolated per signed-in Firebase user.
    // This rule intentionally does not grant access to other application collections.
    match /users/{uid}/snapshots/{snapshotId} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && snapshotId == "latest";
    }
  }
}
