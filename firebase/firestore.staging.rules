rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Staging: authenticated users can access only their own latest ANAS ERP snapshot.
    match /users/{uid}/snapshots/{snapshotId} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && snapshotId == "latest";
    }
  }
}
